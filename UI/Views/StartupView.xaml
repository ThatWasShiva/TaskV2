<UserControl x:Class="TaskManager.UI.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header ─────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Margin="12"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14,10">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Startup Apps" Style="{StaticResource SubtitleText}"/>
                    <TextBlock Margin="0,2,0,0"
                               Foreground="{StaticResource TextTertiaryBrush}" FontSize="12">
                        <Run Text="{Binding StartupVM.EnabledCount}"/>
                        <Run Text="enabled ·"/>
                        <Run Text="{Binding StartupVM.HighImpactCount}"
                             Foreground="{StaticResource OrangeBrush}"/>
                        <Run Text="high impact"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="↻ Refresh" Style="{StaticResource FluentButton}"
                            Command="{Binding StartupVM.RefreshCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Entry List ─────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" Margin="12,0,12,0"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding StartupVM.Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon placeholder -->
                                <Border Grid.Column="0" Width="36" Height="36"
                                        Background="{StaticResource Surface2Brush}"
                                        CornerRadius="6" Margin="0,0,12,0">
                                    <TextBlock Text="🚀" FontSize="18"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="Medium"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Publisher}"
                                               Style="{StaticResource CaptionText}"/>
                                </StackPanel>

                                <!-- Impact badge -->
                                <TextBlock Grid.Column="2" Margin="12,0"
                                           VerticalAlignment="Center" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Impact}"
                                                             Value="High">
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource OrangeBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Impact}"
                                                             Value="Medium">
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource YellowBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Impact}"
                                                             Value="Low">
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource GreenBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="{Binding ImpactLabel}"/>
                                </TextBlock>

                                <!-- Toggle -->
                                <CheckBox Grid.Column="3" VerticalAlignment="Center"
                                          Style="{StaticResource FluentToggle}"
                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                          Command="{Binding DataContext.StartupVM.ToggleCommand,
                                                   RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ── Status ─────────────────────────────────────────────────── -->
        <TextBlock Grid.Row="2" Margin="12,6,12,10"
                   Text="{Binding StartupVM.StatusMessage}"
                   Style="{StaticResource CaptionText}"/>
    </Grid>
</UserControl>
